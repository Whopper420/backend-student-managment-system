@page "/users"
@inject ApiService Api

<PageTitle>Users</PageTitle>

<h2>Users</h2>

@if (error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" @onclick="() => error = null"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Add New User</h5>
    </div>
    <div class="card-body">
        <EditForm Model="newUser" OnValidSubmit="HandleAddUser" class="row g-3">
            <DataAnnotationsValidator />
            <div class="col-md-4">
                <input @bind="newUser.Name" class="form-control" placeholder="Name" required />
            </div>
            <div class="col-md-4">
                <input @bind="newUser.Role" class="form-control" placeholder="Role" required />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary" disabled="@adding">
                    @(adding ? "Adding..." : "Add User")
                </button>
            </div>
        </EditForm>
    </div>
</div>

@if (loading)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else if (users.Count == 0)
{
    <div class="alert alert-info">No users found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in users)
                {
                    <tr>
                        <td>@u.Id</td>
                        <td>@u.Name</td>
                        <td><span class="badge bg-secondary">@u.Role</span></td>
                        <td>
                            <a href="/student/@u.Id" class="btn btn-sm btn-outline-info me-1">View Courses</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<User> users = new();
    private bool loading = true;
    private bool adding;
    private string? error;
    private User newUser = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            loading = true;
            users = await Api.GetUsers();
            error = null;
        }
        catch (Exception ex)
        {
            error = $"Failed to load users: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task HandleAddUser()
    {
        try
        {
            adding = true;
            error = null;
            await Api.AddUser(newUser);
            newUser = new();
            await LoadUsers();
        }
        catch (Exception ex)
        {
            error = $"Failed to add user: {ex.Message}";
        }
        finally
        {
            adding = false;
        }
    }
}
