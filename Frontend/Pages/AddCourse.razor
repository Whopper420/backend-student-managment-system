@page "/add-course"
@inject HttpClient Http

<h3>Add Course</h3>

<input @bind="title" placeholder="Course title" />
<input @bind="teacherId" type="number" placeholder="Teacher ID" />

<button @onclick="CreateCourse">Create</button>

<p>@message</p>

@code {
    string title = "";
    int teacherId;
    string message = "";

    async Task CreateCourse()
    {
        var course = new Course
        {
            Title = title,
            TeacherId = teacherId
        };

        var res = await Http.PostAsJsonAsync("courses", course);

        message = await res.Content.ReadAsStringAsync();
    }
}