@page "/course/{id:int}"
@inject ApiService Api

<PageTitle>Course Students</PageTitle>

<h2>Course Students</h2>

@if (error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" @onclick="() => error = null"></button>
    </div>
}

@if (loading)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else if (users.Count == 0)
{
    <div class="alert alert-info">No students are enrolled in this course.</div>
}
else
{
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Enrolled Students (@users.Count)</h5>
        </div>
        <div class="list-group list-group-flush">
            @foreach (var u in users)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1">@u.Name</h6>
                        <small class="text-muted">Role: @u.Role</small>
                    </div>
                    <a href="/student/@u.Id" class="btn btn-sm btn-outline-primary">View Courses</a>
                </div>
            }
        </div>
    </div>
}

<a href="/courses" class="btn btn-outline-secondary mt-3">&larr; Back to Courses</a>

@code {
    [Parameter] public int id { get; set; }
    private List<User> users = new();
    private bool loading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            users = await Api.GetCourseUsers(id);
        }
        catch (Exception ex)
        {
            error = $"Failed to load course students: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }
}
