@page "/"
@inject ApiService Api

<PageTitle>Dashboard</PageTitle>

<h2>Dashboard</h2>

@if (loading)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else
{
    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card bg-primary text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">Users</h5>
                    <h2 class="display-4">@userCount</h2>
                    <a href="/users" class="text-white">Manage Users &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card bg-success text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">Courses</h5>
                    <h2 class="display-4">@courseCount</h2>
                    <a href="/courses" class="text-white">Manage Courses &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card bg-info text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">Enrollments</h5>
                    <h2 class="display-4">@enrollmentCount</h2>
                    <a href="/enrollments" class="text-white">View All &rarr;</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private int userCount;
    private int courseCount;
    private int enrollmentCount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var users = await Api.GetUsers();
            var courses = await Api.GetCourses();
            var enrollments = await Api.GetEnrollments();

            userCount = users.Count;
            courseCount = courses.Count;
            enrollmentCount = enrollments.Count;
        }
        catch
        {
        }
        finally
        {
            loading = false;
        }
    }
}
