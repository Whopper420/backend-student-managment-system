@page "/enrollment"
@inject ApiService Api

<PageTitle>Enroll Student</PageTitle>

<h2>Enroll Student</h2>

@if (error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" @onclick="() => error = null"></button>
    </div>
}

@if (success != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @success
        <button type="button" class="btn-close" @onclick="() => success = null"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        @if (loading)
        {
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        }
        else
        {
            <EditForm Model="enrollment" OnValidSubmit="HandleEnroll" class="row g-3">
                <DataAnnotationsValidator />
                <div class="col-md-5">
                    <label class="form-label">Select Student</label>
                    <select @bind="enrollment.UserId" class="form-select" required>
                        <option value="0">-- Select a student --</option>
                        @foreach (var user in users)
                        {
                            <option value="@user.Id">@user.Name (@user.Role)</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Select Course</label>
                    <select @bind="enrollment.CourseId" class="form-select" required>
                        <option value="0">-- Select a course --</option>
                        @foreach (var course in courses)
                        {
                            <option value="@course.Id">@course.Title</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100" disabled="@enrolling">
                        @(enrolling ? "Enrolling..." : "Enroll")
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    private List<User> users = new();
    private List<Course> courses = new();
    private bool loading = true;
    private bool enrolling;
    private string? error;
    private string? success;
    private EnrollmentRequest enrollment = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userTask = Api.GetUsers();
            var courseTask = Api.GetCourses();

            await Task.WhenAll(userTask, courseTask);

            users = userTask.Result;
            courses = courseTask.Result;
        }
        catch (Exception ex)
        {
            error = $"Failed to load data: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task HandleEnroll()
    {
        if (enrollment.UserId == 0 || enrollment.CourseId == 0)
        {
            error = "Please select both a student and a course.";
            return;
        }

        try
        {
            enrolling = true;
            error = null;
            success = null;

            var result = await Api.EnrollUser(enrollment);
            success = result;
            enrollment = new();
        }
        catch (Exception ex)
        {
            error = $"Failed to enroll: {ex.Message}";
        }
        finally
        {
            enrolling = false;
        }
    }
}
